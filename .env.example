# ─────────────────────────────────────────────
#  تفريغ — متغيرات البيئة
#  انسخ هذا الملف إلى ‎.env‎ واملأ القيم
# ─────────────────────────────────────────────

# قاعدة البيانات والطوابير
DATABASE_URL=postgres://tafreegh:tafreegh@localhost:5432/tafreegh
REDIS_URL=redis://localhost:6379

# ─── الإنتاج فقط (docker-compose.prod.yml) ───
# النطاق الذي يستخرج له Caddy شهادة HTTPS
DOMAIN=
# كلمة مرور قاعدة البيانات — ولّدها بـ: openssl rand -base64 24
POSTGRES_PASSWORD=

# مسار تخزين الوسائط المؤقتة (تُحذف بعد الاعتماد)
STORAGE_DIR=./storage

# سرّ توقيع الجلسات — ولّده بـ: openssl rand -base64 32
# تغييره يُخرج كل من سجّل الدخول.
AUTH_SECRET=

# ─── مزوّدو النماذج (كلهم بطبقات مجانية) ───
# Groq — التفريغ الأساسي + نماذج نصية احتياطية
# احصل على مفتاح من https://console.groq.com/keys
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3

# Gemini — التفريغ الثاني + المراجعتان
# احصل على مفتاح من https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_ASR_MODEL=gemini-2.5-flash
GEMINI_REVIEW_MODEL=gemini-2.5-flash
GEMINI_AUDIT_MODEL=gemini-2.5-pro

# ─── المسار المحلي لوضع «مشروع خاص» ───
# يعمل بلا إنترنت ولا حصص، ولا يغادر المقطعُ خادمك.
# أبطأ وأقل دقة — وهذا ثمن الخصوصية.

# المراجعة محليًا عبر Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# التفريغ محليًا. اتركه فارغًا لتعطيل الوضع المحلي.
# مثال: pip install faster-whisper ثم
# LOCAL_ASR_COMMAND=whisper-ctranslate2
LOCAL_ASR_COMMAND=
LOCAL_ASR_MODEL=large-v3

# ─── حدود التزامن لكل مرحلة ───
CONCURRENCY_PREPARE=2
CONCURRENCY_TRANSCRIBE=4
CONCURRENCY_REVIEW=3
CONCURRENCY_AUDIT=2

# ─── مفاتيح تشغيل ───
# تنزيل يوتيوب معطّل افتراضيًا — راجع تحذير §5 في docs/PLAN.md
ENABLE_YOUTUBE=false

# ─── سياسة الاحتفاظ ───
# حذف الوسائط تلقائيًا بعد هذا العدد من الأيام حتى دون اعتماد
MEDIA_TTL_DAYS=14

# وضع العرض التجريبي: محرّكان ومراجع محاكَون بدل النماذج الحقيقية، لتجربة
# المسار كاملًا بلا مفاتيح. يحتاج نصًّا مرجعيًّا من scripts/demo/make-audio.py.
# لا تفعّله في الإنتاج.
DEMO_MODE=false
DEMO_SCRIPT=eval/demo/script.json
# false: المحرّك الثاني المحاكى لا يميّز المتحدثين، فيُستنتجون من النصّ
DEMO_DIARIZE=true
