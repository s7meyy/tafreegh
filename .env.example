# ─────────────────────────────────────────────
#  تفريغ — متغيرات البيئة
#  انسخ هذا الملف إلى ‎.env‎ واملأ القيم
# ─────────────────────────────────────────────

# قاعدة البيانات والطوابير
DATABASE_URL=postgres://tafreegh:tafreegh@localhost:5432/tafreegh
REDIS_URL=redis://localhost:6379

# مسار تخزين الوسائط المؤقتة (تُحذف بعد الاعتماد)
STORAGE_DIR=./storage

# ─── مزوّدو النماذج (كلهم بطبقات مجانية) ───
# Groq — التفريغ الأساسي + نماذج نصية احتياطية
# احصل على مفتاح من https://console.groq.com/keys
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3

# Gemini — التفريغ الثاني + المراجعتان
# احصل على مفتاح من https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_ASR_MODEL=gemini-2.5-flash
GEMINI_REVIEW_MODEL=gemini-2.5-flash
GEMINI_AUDIT_MODEL=gemini-2.5-pro

# Ollama — المسار المحلي لوضع «مشروع خاص» (اختياري)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ─── حدود التزامن لكل مرحلة ───
CONCURRENCY_PREPARE=2
CONCURRENCY_TRANSCRIBE=4
CONCURRENCY_REVIEW=3
CONCURRENCY_AUDIT=2

# ─── مفاتيح تشغيل ───
# تنزيل يوتيوب معطّل افتراضيًا — راجع تحذير §5 في docs/PLAN.md
ENABLE_YOUTUBE=false

# ─── سياسة الاحتفاظ ───
# حذف الوسائط تلقائيًا بعد هذا العدد من الأيام حتى دون اعتماد
MEDIA_TTL_DAYS=14
