# Caddy يتولّى شهادة HTTPS تلقائيًا من Let's Encrypt.
# كوكي الجلسة يُرسَل `secure` في الإنتاج، فلا يعمل الدخول على HTTP أصلًا.

{$DOMAIN} {
	encode zstd gzip

	# قطع الرفع تصل بحجم 8 ميغابايت، والسقف 16. نترك هامشًا فوقها.
	request_body {
		max_size 24MB
	}

	# الرفع المجزّأ يرسل ملفًا بحجم غيغابايت على دفعات؛ المهلة الافتراضية
	# تقطع القطعة البطيئة على اتصال ضعيف.
	reverse_proxy web:3000 {
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}

	header {
		# HSTS: بعد أول زيارة لا يقبل المتصفح HTTP لهذا النطاق.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
